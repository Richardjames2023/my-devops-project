NODE_ENV=development

PORT=5000

DATABASE_URL=

CORS_ORIGIN=

# Generate a unique secret of at least 32 characters for each environment.
JWT_ACCESS_SECRET=

# Stable, unique secret (at least 32 characters) used to HMAC coupon customer identifiers.
# Keep this value unchanged across deployments to preserve per-customer redemption limits.
COUPON_CUSTOMER_HASH_SECRET=

# Paystack secret key. Required when NODE_ENV=production.
PAYSTACK_SECRET_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email delivery. Required in production because customer email verification is mandatory.
# Configure Resend events: email.sent, email.delivered, email.delivery_delayed, email.bounced, email.complained, email.failed, email.suppressed
# Webhook URL: /api/v1/notifications/webhooks/resend
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
APP_BASE_URL=

# Nationwide delivery zone seed fees (NGN). Set all six before running prisma/seed.ts.
# Use business-approved amounts; partial configuration is rejected.
DELIVERY_FEE_NORTH_CENTRAL=
DELIVERY_FEE_NORTH_EAST=
DELIVERY_FEE_NORTH_WEST=
DELIVERY_FEE_SOUTH_EAST=
DELIVERY_FEE_SOUTH_SOUTH=
DELIVERY_FEE_SOUTH_WEST=
