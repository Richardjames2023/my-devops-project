# Public provider identifiers used by the browser SDKs.
# The matching server-side GOOGLE_CLIENT_ID and FACEBOOK_APP_ID must be configured in backend/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Backend API base URL, e.g. http://localhost:5000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
